# Copiar como .env y poner los valores reales. El .env NO se versiona.
#
#   cp .env.example .env
#
# Estas variables las lee src/main/resources/application.yaml.

# Cadena JDBC de Oracle. Ajustar el nombre del servicio segun tu instalacion:
#   Oracle 19c / instalacion tipica -> orclpdb
#   Oracle XE 21c                   -> XEPDB1
#   Oracle 23ai Free                -> FREEPDB1
# Para ver el nombre real de tu servicio: lsnrctl status
DB_URL=jdbc:oracle:thin:@localhost:1521/orclpdb

# Esquema donde se corrio database/01-schema-completo.sql
DB_USERNAME=seguridad_user

# Debe coincidir con el password del CREATE USER que se corrio a mano
# (ver el encabezado de database/01-schema-completo.sql)
DB_PASSWORD=changeme
